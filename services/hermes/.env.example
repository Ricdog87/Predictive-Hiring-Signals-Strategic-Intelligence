# --- Hermes server ---
HERMES_HOST=0.0.0.0
HERMES_PORT=4001
# When set, every request must carry `Authorization: Bearer <key>`.
# Leave blank ONLY for local dev; never in production.
HERMES_API_KEY=

# --- OpenRouter ---
# Required. Get a key at https://openrouter.ai
OPENROUTER_API_KEY=

# Model tiering (defaults shown). Pick from
# https://openrouter.ai/models — anything chat-completable works.
OPENROUTER_MODEL_FAST=openai/gpt-4o-mini
OPENROUTER_MODEL_DEEP=anthropic/claude-3.5-haiku
# `live` tier — Perplexity Sonar with web access, used by the regional
# insight endpoint to ground answers in current sources.
OPENROUTER_MODEL_LIVE=perplexity/sonar

# Per-call max tokens (hard cap).
OPENROUTER_MAX_TOKENS_FAST=600
OPENROUTER_MAX_TOKENS_DEEP=1500
OPENROUTER_MAX_TOKENS_LIVE=800

# Hard request timeout in ms. Below this, fall back deterministically.
OPENROUTER_TIMEOUT_MS=25000

# Optional metadata sent to OpenRouter for ranking/attribution.
OPENROUTER_REFERER=https://rsg-hiring-radar.local
OPENROUTER_APP_NAME=RSG Hermes

# --- Cost guardrails (per-tier) ---
HERMES_RPM_FAST=30
HERMES_RPM_DEEP=6
HERMES_RPM_LIVE=4
HERMES_RPD_FAST=3000
HERMES_RPD_DEEP=200
HERMES_RPD_LIVE=100

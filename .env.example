# =============================================================================
# Hiring Radar · environment template
# =============================================================================
# Copy to `.env.local` for local dev or set on Vercel for prod.
# NEVER commit a real `.env` / `.env.local` (already gitignored).

# --- Identity (UI) ----------------------------------------------------------
# Default user shown in the welcome banner / header / sidebar.
NEXT_PUBLIC_USER_NAME=Ricardo
NEXT_PUBLIC_USER_ROLE=Recruiting SG · Internal

# --- Live ingest ------------------------------------------------------------
# When set, POST /api/ingest requires `Authorization: Bearer <token>`.
INGEST_TOKEN=

# Optional persistent store for ingested signals (Vercel KV / Upstash REST).
# When unset, signals live in a per-instance memory ring buffer.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Hermes (LLM analysis service) -----------------------------------------
# Where the radar reaches Hermes. Leave blank to fully disable Hermes —
# /api/hermes/* will return graceful fallbacks and the dashboard stays green.
HERMES_BASE_URL=
HERMES_API_KEY=
HERMES_TIMEOUT_MS=25000
# Deeper requests (opportunity brief) get a longer leash.
HERMES_TIMEOUT_MS_DEEP=35000

# --- MiroFish (optional / stub in v1) --------------------------------------
# v1 ships MiroFish as a stub adapter only. Leaving these unset is the
# expected default; no surface depends on MiroFish.
MIROFISH_BASE_URL=
MIROFISH_API_KEY=
MIROFISH_TIMEOUT_MS=8000

# --- Live job-market source · Adzuna (optional) ----------------------------
# Free tier at https://developer.adzuna.com/ — leave blank to disable
# /api/jobmarket/pulse and the jobMarket section of /api/intel/snapshot.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_TIMEOUT_MS=8000
ADZUNA_REVALIDATE_SECONDS=1800

# --- SaaS API-key gating (optional) ----------------------------------------
# Comma-separated list of `<key>:<hourlyQuota>` entries. When unset,
# /api/intel/snapshot is open. When set, every request must carry
# Authorization: Bearer <key>.
#
#   EXTERNAL_API_KEYS="key_demo:60,key_pro_acme:600,key_enterprise:6000"
#
EXTERNAL_API_KEYS=
EXTERNAL_API_DEFAULT_QUOTA=60

# --- Admin bootstrap --------------------------------------------------------
# Single bearer token that gates /api/admin/* routes (settings, health, and
# the Engine Status footer widget that reads /api/admin/llm-budget). Set
# this ONCE on Vercel. The /admin/settings page asks for it on first load
# and stores it under localStorage key `rsg.admin.token.v1`; the footer
# Engine Status widget reads the same key to decide whether to render. No
# additional env var is needed for the widget itself — it reuses the
# existing forecast engine API key for the upstream budget probe.
ADMIN_TOKEN=

# --- Macro fetch tuning -----------------------------------------------------
MACRO_TIMEOUT_MS=8000
MACRO_REVALIDATE_SECONDS=21600

# --- Hermes Strategy Lab (premium / multi-agent) ---------------------------
# Single-Mega-Call gegen ein Frontier-Modell via OpenRouter. Simuliert
# intern ein 7er-Vorstandsgremium. Wenn der dedizierte Sub-Key nicht
# gesetzt ist, fällt der Client zurück auf HERMES_FORECAST_API_KEY →
# HERMES_API_KEY → OPENROUTER_API_KEY (siehe lib/strategyLab.ts).
HERMES_STRATEGY_LAB_API_KEY=
HERMES_STRATEGY_LAB_MODEL=anthropic/claude-sonnet-4.6
HERMES_STRATEGY_LAB_TIMEOUT_MS=120000
HERMES_STRATEGY_LAB_HTTP_REF=https://predictive-hiring-signals-strategic.vercel.app
HERMES_STRATEGY_LAB_APP_TITLE=RSG Strategy Lab
# Optional override für lokale Mocks / Self-Hosted-Gateway.
HERMES_STRATEGY_LAB_BASE_URL=
# Stündliches Run-Limit pro API-Key (default 10).
STRATEGY_LAB_QUOTA=10
# Komma-separierte Allowlist von externen API-Keys, die das Lab nutzen
# dürfen. Leer = jeder authentifizierte Key darf rein (siehe Tier-Gate
# in app/api/forecast/strategy-lab/route.ts).
STRATEGY_LAB_TIER_ALLOWLIST=

# --- Supabase persistence (recommended for production) ---------------------
# When both are set, /api/ingest persists every signal to the
# `ingest_signals` table; reads merge Supabase + warm-lambda memory.
# Without these, the radar falls back to in-memory ring buffer.
#
# 1. Create a Supabase project (free tier is enough for v1).
# 2. Run `supabase/migrations/0001_init.sql` in the Supabase SQL editor.
# 3. Copy your project URL + the service_role key (Settings → API).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TIMEOUT_MS=6000
